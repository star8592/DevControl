{
  "integrations": {
    "codex": {
      "enabled": false,
      "mode": "supervised",
      "transport": "local-cli",
      "capabilities": ["plan", "review"],
      "allowProjectPathsOnly": true,
      "allowArbitraryShell": false,
      "contextPolicy": "repository-read-only",
      "requireApprovalFor": ["edit", "test", "push", "merge", "release", "production-write"]
    },
    "openai": {
      "enabled": false,
      "mode": "supervised",
      "transport": "api",
      "protocol": "responses",
      "model": "",
      "capabilities": ["chat", "summarize", "triage", "plan", "review"],
      "contextPolicy": "bounded-project-metadata",
      "sendSecrets": false,
      "sendUnredactedLogs": false,
      "apiKeyEnv": "OPENAI_API_KEY",
      "maxOutputTokens": 2400
    },
    "localModel": {
      "enabled": false,
      "mode": "supervised",
      "transport": "openai-compatible-http",
      "endpoint": "http://127.0.0.1:11434/v1",
      "protocol": "chat-completions",
      "model": "",
      "capabilities": ["chat", "summarize", "triage", "plan", "review"],
      "contextPolicy": "bounded-project-metadata"
    },
    "git": {
      "enabled": true,
      "mode": "read-only",
      "transport": "local-cli",
      "capabilities": ["status", "diff", "log"],
      "writeCommands": false
    },
    "githubCli": {
      "enabled": true,
      "mode": "read-only",
      "transport": "local-cli",
      "capabilities": ["auth-status", "repo-view", "pr-view", "run-view"]
    },
    "editor": {
      "enabled": false,
      "mode": "supervised",
      "transport": "local-launcher",
      "command": "code",
      "capabilities": ["open-project"]
    },
    "githubDesktop": {
      "enabled": false,
      "mode": "disabled",
      "transport": "local-launcher",
      "capabilities": ["open-project"],
      "note": "Optional on supported desktop operating systems; not a Linux dependency."
    }
  },
  "security": {
    "bindLocalhostOnly": true,
    "browserNeverReceivesTokens": true,
    "rejectArbitraryCommandText": true,
    "auditEveryWriteAction": true,
    "defaultWritePolicy": "deny"
  }
}
