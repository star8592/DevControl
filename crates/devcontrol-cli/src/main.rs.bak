use devcontrol_core::modules::delivery;
use devcontrol_core::discover;


fn main(){

    let args:Vec<String>=std::env::args().collect();


    if args.len()>1 && args[1]=="discover"{

        discover(
            "/mnt/disk1/Code"
        );

    }else{

        println!(
            "Usage: devctl discover"
        );

    }

}
