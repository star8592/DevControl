# Fine-grained GitHub token. Keep this server-side only.
# Read: repository metadata, Actions, issues, pull requests, runners.
# Optional Actions: write for rerun-failed control.
GITHUB_TOKEN=

DEVCONTROL_OWNER=star8592
HOST=127.0.0.1
PORT=8787

# Automatic local project discovery.
DEVCONTROL_DISCOVERY_ROOTS=/mnt/disk1/Code:/mnt/disk2
DEVCONTROL_DISCOVERY_MAX_DEPTH=3
DEVCONTROL_DISCOVERY_INTERVAL_SEC=60
DEVCONTROL_DISCOVERY_FILE=state/discovery.json

# Unified safe qualification executor + project learner.
DEVCONTROL_STATE_DIR=state
DEVCONTROL_QUALIFY_INTERVAL_SEC=120
DEVCONTROL_QUALIFY_TIMEOUT_MS=900000
