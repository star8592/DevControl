# Fine-grained GitHub token. Keep this server-side only.
# Read: repository metadata, Actions, issues, pull requests, runners.
# Optional write scopes are needed only for issue/comment/PR reporting or rerun controls.
GITHUB_TOKEN=

DEVCONTROL_OWNER=star8592
HOST=127.0.0.1
PORT=8787

# Zero-config local project discovery.
DEVCONTROL_DISCOVERY_ROOTS=/mnt/disk1/Code:/mnt/disk2
DEVCONTROL_DISCOVERY_MAX_DEPTH=3
DEVCONTROL_DISCOVERY_FILE=state/discovery.json

# Installed systems set this to ~/.config/devcontrol/projects.local.json.
# It stores machine-specific visual policy only; repository/release policy cannot be overridden here.
DEVCONTROL_PROJECT_OVERRIDES_FILE=

# Serialized autonomous loop:
# discover -> safe sync -> discover -> qualify -> optional visual gate -> failure packet
# -> repair plan -> optional isolated auto-fix -> optional repair branch/Draft PR -> dashboard.
DEVCONTROL_STATE_DIR=state
DEVCONTROL_RECONCILE_INTERVAL_SEC=60
DEVCONTROL_QUALIFY_TIMEOUT_MS=900000

# Visual qualification is per-project opt-in. V0.13 can opt in locally without editing GitHub config:
#   devctl visual-enable dandao
#   devctl visual-run dandao
#   devctl qualify --project dandao --managed --force
DEVCONTROL_GODOT_BIN=godot
DEVCONTROL_VISUAL_TIMEOUT_MS=300000

# Failure/repair reporting to GitHub is opt-in. Local packets/plans are always generated.
DEVCONTROL_GITHUB_FAILURE_ISSUES=0
DEVCONTROL_GITHUB_REPAIR_PLAN_COMMENTS=0

# PLAN_ONLY repair supervisor. "heuristic" uses no external AI.
# Set to "codex" to let Codex inspect the repository in a read-only sandbox.
DEVCONTROL_REPAIR_PLANNER=heuristic
DEVCONTROL_REPAIR_PLAN_TIMEOUT_MS=180000

# Experimental isolated AUTO_FIX. Disabled by default.
# When enabled, Codex workspace-write runs only inside a dedicated git worktree/repair branch.
# It cannot deploy, release, merge, or modify blocked high-risk paths.
DEVCONTROL_AUTO_FIX=0
DEVCONTROL_AUTO_FIX_TIMEOUT_MS=600000

# External repair publication has two independent opt-ins.
# PUSH uploads only the already-qualified devcontrol/repair/* branch.
# CREATE_REPAIR_PR requires PUSH=1 and creates a Draft PR only; DevControl never auto-merges it.
DEVCONTROL_AUTO_PUSH_REPAIR_BRANCH=0
DEVCONTROL_AUTO_CREATE_REPAIR_PR=0
