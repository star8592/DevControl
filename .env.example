# Fine-grained GitHub token. Keep this server-side only.
# Read: repository metadata, Actions, issues, pull requests, runners.
# Optional Actions: write for rerun-failed control.
GITHUB_TOKEN=

DEVCONTROL_OWNER=star8592
HOST=127.0.0.1
PORT=8787

# Zero-config local project discovery.
DEVCONTROL_DISCOVERY_ROOTS=/mnt/disk1/Code:/mnt/disk2
DEVCONTROL_DISCOVERY_MAX_DEPTH=3
DEVCONTROL_DISCOVERY_FILE=state/discovery.json

# Serialized autonomous loop:
# discover -> safe sync -> discover -> qualify -> failure packet -> repair plan -> dashboard.
DEVCONTROL_STATE_DIR=state
DEVCONTROL_RECONCILE_INTERVAL_SEC=60
DEVCONTROL_QUALIFY_TIMEOUT_MS=900000

# AI failure packets are always local. GitHub issue creation is opt-in.
DEVCONTROL_GITHUB_FAILURE_ISSUES=0

# PLAN_ONLY repair supervisor. "heuristic" uses no external AI.
# Set to "codex" to let Codex inspect the repository in a read-only sandbox.
DEVCONTROL_REPAIR_PLANNER=heuristic
DEVCONTROL_REPAIR_PLAN_TIMEOUT_MS=180000
